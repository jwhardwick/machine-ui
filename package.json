{
  "name": "machine-ui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "storybook": "pnpm --filter @machine-ui/storybook storybook",
    "test:storybook": "pnpm --filter @machine-ui/storybook test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm size && pnpm test:storybook && pnpm test:visual && pnpm test:site",
    "changeset": "changeset",
    "test:site": "pnpm --filter @machine-ui/site test",
    "build:site": "pnpm --filter @machine-ui/site build",
    "api:report": "node tooling/release/src/cli/report.ts",
    "release:bump": "node tooling/release/src/cli/bump.ts",
    "size": "size-limit",
    "test:visual": "pnpm --filter @machine-ui/storybook test:visual",
    "registry:build": "node tooling/registry/src/cli.ts",
    "test:registry-install": "node tooling/registry/src/install-smoke.ts"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "@machine-ui/eslint-plugin": "workspace:*",
    "@machine-ui/release-tools": "workspace:*",
    "size-limit": "14.2.0",
    "@size-limit/esbuild": "14.2.0",
    "@size-limit/file": "14.2.0"
  }
}
