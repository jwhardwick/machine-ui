{
  "name": "machine-ui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "storybook": "pnpm --filter @machine-ui/storybook storybook",
    "test:storybook": "pnpm --filter @machine-ui/storybook test",
    "build:site": "pnpm --filter @machine-ui/site build",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:storybook && pnpm build:site",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
